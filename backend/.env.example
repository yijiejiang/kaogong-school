APP_SECRET_KEY=dev-secret-change-me
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL (after `make infra`):
# DATABASE_URL=postgresql+asyncpg://kaogong:kaogong@localhost:5433/kaogong
# ADK_DATABASE_URL=postgresql+asyncpg://kaogong:kaogong@localhost:5433/kaogong

CORS_ORIGINS=http://localhost:3000
# Public URL used by the iPad/iPhone QR code, e.g.
# https://mac-mini.tailxxxx.ts.net (Tailscale Serve) or a Cloudflare Tunnel URL.
# Leave empty to auto-detect the Mac LAN IP.
PUBLIC_BASE_URL=
DEFAULT_USER_ID=local-user
# Local demo mode: works without an external LLM key. Set to 0 for real models.
MOCK_LLM=0
# Extract knowledge units and skills after each material is indexed.
ENABLE_KNOWLEDGE_EXTRACTION=1

# Optional bootstrap LLM config. The Settings page overrides these values.
LLM_API_BASE=
LLM_API_KEY=
LLM_DEFAULT_MODEL=
# Optional: e.g. text-embedding-3-small or bge-m3. Empty uses local hash vectors.
LLM_EMBEDDING_MODEL=

# Optional speech-to-text model for OpenAI-compatible /audio/transcriptions.
# Empty defaults to whisper-1 when an API base/key is configured.
ASR_MODEL=
# Local faster-whisper model used when no ASR API is configured.
# base is fastest, small is a good Chinese balance, medium is more accurate.
ASR_LOCAL_MODEL=small

# Optional web search for the collector agent.
TAVILY_API_KEY=

# Optional DeepSeek official APIs for web search/fetch, scanned-PDF OCR and
# short-audio ASR. These do NOT affect the chat model endpoint.
# Set them in the Settings page instead, or provide them here as defaults.
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
